---
import Layout from "@layouts/Layout.astro";
import Hero from "@components/home/Hero.astro";
import Marques from "@components/home/Marques.astro";
import Serveis from "@components/home/Serveis.astro";
import Ofertes from "@components/home/Ofertes.astro";
import Xifres from "@components/home/Xifres.astro";
import Productes from "@components/home/Productes.astro";
import Visita from "@components/home/Visita.astro";
import { getLocaleFromPath, getLocalizedData } from "@/utils/i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const seo = getLocalizedData<any>(locale, "home").seo;
---

<Layout title={seo?.title} description={seo?.description} ogImage={seo?.ogImage} flush>
  <Hero />
  <Marques />
  <Serveis />
  <Ofertes />
  <Xifres />
  <Productes />
  <Visita />
</Layout>
