---
import Layout from "@layouts/Layout.astro";
import CapPagina from "@components/ui/CapPagina.astro";
import Icon from "@components/ui/Icon.astro";
import EstatBotiga from "@components/ui/EstatBotiga.astro";
import OnSom from "@components/ui/OnSom.astro";
import { getLocaleFromPath, getLocalizedData, localizePath } from "@/utils/i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const c = getLocalizedData<any>(locale, "contact");
const comu = getLocalizedData<any>(locale, "site").comu;
const labels = c.page.labels;
const info = c.contactInfo;
const f = c.form.fields;

const channels = [
  { icon: "telefon", label: labels.phone, value: info.phone.display, href: `tel:${info.phone.display.replace(/\s+/g, "")}` },
  { icon: "whatsapp", label: "WhatsApp", value: c.socialMedia.whatsapp.text, href: c.socialMedia.whatsapp.url, external: true },
  { icon: "correu", label: "Email", value: info.email.address, href: `mailto:${info.email.address}` },
  { icon: "instagram", label: "Instagram", value: c.socialMedia.instagram.text, href: c.socialMedia.instagram.url, external: true },
  { icon: "facebook", label: "Facebook", value: c.socialMedia.facebook.text, href: c.socialMedia.facebook.url, external: true },
];

const fields: { id: string; type: "text" | "email" | "tel"; autocomplete?: any }[] = [
  { id: "name", type: "text", autocomplete: "name" },
  { id: "email", type: "email", autocomplete: "email" },
  { id: "phone", type: "tel", autocomplete: "tel" },
  { id: "subject", type: "text" },
];
---

<Layout title={c.seo?.title} description={c.seo?.description} ogImage={c.seo?.ogImage}>
  <CapPagina eyebrow={c.hero.badge.text} title={c.hero.title.main} italic={c.hero.title.highlight} subtitle={c.hero.subtitle} ctas={false} />

  <section class="bg-crema-50 py-20 sm:py-24">
    <div class="contenidor grid gap-14 lg:grid-cols-12 lg:gap-16">
      <!-- Canals directes -->
      <div class="min-w-0 lg:col-span-5">
        <h2 class="text-3xl sm:text-4xl" data-split>{comu.form.channels}</h2>
        <EstatBotiga class="mt-6" />
        <ul class="mt-8 divide-y divide-bosc-900/10 border-y border-bosc-900/10" data-reveal-stagger>
          {channels.map((ch) => (
            <li>
              <a
                href={ch.href}
                target={ch.external ? "_blank" : undefined}
                rel={ch.external ? "noopener noreferrer" : undefined}
                class="group flex items-center gap-5 py-5"
              >
                <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-crema-100 text-bosc-700 transition-colors duration-500 group-hover:bg-bosc-700 group-hover:text-crema-50">
                  <Icon name={ch.icon} size={22} />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block text-sm text-tinta-suau">{ch.label}</span>
                  <span class="block truncate text-lg font-semibold text-tinta">{ch.value}</span>
                </span>
                <Icon name={ch.external ? "fletxa-diag" : "fletxa"} size={20} class="shrink-0 text-bosc-600 transition-transform duration-500 ease-out-soft group-hover:translate-x-1" />
              </a>
            </li>
          ))}
        </ul>

        <ul class="mt-10 grid gap-6 sm:grid-cols-3 lg:grid-cols-1" data-reveal-stagger>
          {c.features.map((ft: any) => (
            <li class="flex gap-4">
              <Icon name={ft.icon} size={24} class="mt-0.5 shrink-0 text-fusta-500" />
              <div>
                <h3 class="font-sans text-base font-semibold text-tinta" style="letter-spacing:0">{ft.title}</h3>
                <p class="text-sm text-tinta-suau">{ft.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <!-- Formulari (s'envia a formsubmit.co) -->
      <div id="contact" class="min-w-0 scroll-mt-28 lg:col-span-7">
        <div class="paper rounded-[2rem] bg-crema-100 p-6 sm:p-10" data-reveal>
          <h2 class="text-3xl sm:text-4xl">{c.form.title}</h2>
          <p class="mt-3 text-tinta-suau">{c.form.subtitle}</p>

          <div id="form-success" class="mt-6 hidden items-center gap-3 rounded-2xl bg-bosc-700 px-5 py-4 text-crema-50" role="status">
            <Icon name="check" size={22} />
            <p class="font-medium">{comu.form.sent}</p>
          </div>

          <form id="contact-form" class="mt-8 grid gap-x-6 gap-y-7 sm:grid-cols-2" action={`https://formsubmit.co/${info.email.address}`} method="POST">
            <input type="hidden" name="_subject" value="Nuevo mensaje de un cliente - Òptica Guinart" />
            <input type="hidden" name="_template" value="table" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <input type="hidden" name="_next" id="form-next" value="" data-path={localizePath("/contact", locale)} />

            {fields.map((fd) => (
              <div class="camp">
                <label for={fd.id} class="block text-sm font-semibold text-tinta">
                  {f[fd.id].label}
                  {f[fd.id].required && <span class="text-bosc-600" aria-hidden="true"> *</span>}
                </label>
                <input
                  id={fd.id}
                  name={fd.id}
                  type={fd.type}
                  autocomplete={fd.autocomplete}
                  placeholder={f[fd.id].placeholder}
                  required={f[fd.id].required}
                  class="mt-2 w-full border-0 border-b border-bosc-900/20 bg-transparent px-0 py-2.5 text-lg text-tinta placeholder:text-tinta-suau/50 focus:border-bosc-700 focus:ring-0 focus:outline-none"
                />
              </div>
            ))}
            <div class="camp sm:col-span-2">
              <label for="message" class="block text-sm font-semibold text-tinta">
                {f.message.label}<span class="text-bosc-600" aria-hidden="true"> *</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required={f.message.required}
                placeholder={f.message.placeholder}
                class="mt-2 w-full resize-y border-0 border-b border-bosc-900/20 bg-transparent px-0 py-2.5 text-lg text-tinta placeholder:text-tinta-suau/50 focus:border-bosc-700 focus:ring-0 focus:outline-none"
              ></textarea>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-4 sm:col-span-2">
              <p class="text-xs text-tinta-suau">* {comu.form.required}</p>
              <button type="submit" class="boto boto-primari">
                <Icon name="enviar" size={18} /> {c.form.button.text}
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <OnSom />
</Layout>

<style>
  .camp input:focus-visible,
  .camp textarea:focus-visible {
    outline: none;
    border-bottom-width: 2px;
  }
</style>

<script>
  // Redirecció després d'enviar (a la pàgina de contacte del mateix idioma) i avís d'èxit
  const next = document.getElementById("form-next") as HTMLInputElement | null;
  if (next) next.value = `${location.origin}${next.dataset.path}?sent=1#contact`;
  if (new URLSearchParams(location.search).get("sent") === "1") {
    const ok = document.getElementById("form-success");
    ok?.classList.remove("hidden");
    ok?.classList.add("flex");
  }
</script>
