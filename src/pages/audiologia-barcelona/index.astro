---
import Layout from "@layouts/Layout.astro";
import CapPagina from "@components/ui/CapPagina.astro";
import Titol from "@components/ui/Titol.astro";
import Icon from "@components/ui/Icon.astro";
import Preguntes from "@components/ui/Preguntes.astro";
import OnSom from "@components/ui/OnSom.astro";
import Crida from "@components/ui/Crida.astro";
import GuiesRelacionades from "@components/guies/GuiesRelacionades.astro";
import { getLocaleFromPath, getLocalizedData, localizePath } from "@/utils/i18n";
import taulell from "@assets/fotos/interior-taulell.webp";

const locale = getLocaleFromPath(Astro.url.pathname);
const contactData = getLocalizedData<any>(locale, "contact");
const d = getLocalizedData<any>(locale, "audiologia-barcelona");
const comu = getLocalizedData<any>(locale, "site").comu;
const s = d.sections;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString();

const benefitIcons = ["check", "bateria", "orella", "escut", "bluetooth", "audifon"];
const serviceIcons = ["orella", "audifon", "eina", "aigua"];
const whyIcons = ["medalla", "cor", "precisio"];
---

<Layout title={d.seo.title} description={d.seo.description} ogImage={d.seo.ogImage}>
  <CapPagina
    eyebrow={d.hero.badge}
    title={`${d.hero.title.line1.text} ${d.hero.title.line1.highlight}`}
    italic={d.hero.title.line2.text}
    subtitle={d.hero.subtitle}
    image={taulell}
    imageAlt={s.schema.businessName}
    imagePosition="45% 60%"
  >
    <ul class="mt-9 flex flex-wrap gap-2" data-reveal-stagger>
      {d.benefits.map((b: any, i: number) => (
        <li class="inline-flex items-center gap-2 rounded-full border border-bosc-700/15 bg-crema-50 px-4 py-2 text-sm font-medium">
          <Icon name={benefitIcons[i] ?? "check"} size={18} class="text-bosc-600" />
          {b.title}
        </li>
      ))}
    </ul>
  </CapPagina>

  <!-- Serveis -->
  <section class="bg-crema-50 py-24 sm:py-28">
    <div class="contenidor">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <Titol eyebrow={s.services.titlePrefix + s.services.titleHighlight} title={s.services.subtitle} />
        <p class="max-w-sm text-tinta-suau" data-reveal>
          {s.modelsCta.prefix}<a href={localizePath(s.modelsCta.path, locale)} class="enllac">{s.modelsCta.linkText}</a>.
        </p>
      </div>
      <ol class="mt-14 grid border-t border-bosc-900/10 md:grid-cols-2" data-reveal-stagger>
        {d.services.map((sv: any, i: number) => (
          <li class={`flex gap-6 border-b border-bosc-900/10 py-10 md:px-8 ${i % 2 === 0 ? "md:border-r md:pl-0" : "md:pr-0"}`}>
            <span class="font-display text-3xl text-fusta-500 italic" style="font-weight:300">0{i + 1}</span>
            <div>
              <Icon name={serviceIcons[i] ?? "orella"} size={32} class="text-bosc-600" />
              <h3 class="mt-4 text-3xl">{sv.title}</h3>
              <p class="mt-3 text-lg text-tinta-suau">{sv.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Per què nosaltres -->
  <section class="relative overflow-hidden bg-bosc-900 py-24 text-crema-100 sm:py-28">
    <svg class="pointer-events-none absolute -top-32 -left-32 h-[32rem] w-[32rem] text-crema-50/[0.05]" viewBox="0 0 200 200" fill="none" stroke="currentColor" aria-hidden="true">
      {[30, 50, 70, 90].map((r) => <circle cx="100" cy="100" r={r} stroke-width="1" />)}
    </svg>
    <div class="contenidor relative">
      <Titol title={s.whyChoose.title} italic={`${s.whyChoose.brand}?`} dark />
      <ul class="mt-14 grid gap-10 md:grid-cols-3 md:gap-8" data-reveal-stagger>
        {s.whyChoose.items.map((it: any, i: number) => (
          <li class="border-t border-crema-50/15 pt-8">
            <Icon name={whyIcons[i]} size={34} class="text-fusta-300" />
            <h3 class="mt-5 text-2xl !text-crema-50">{it.title}</h3>
            <p class="mt-3 text-crema-200">{it.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <GuiesRelacionades category="audiologia" />

  <OnSom />

  <!-- Preguntes -->
  <section class="bg-crema-100 py-24 sm:py-28">
    <div class="contenidor grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <Titol eyebrow={comu.faqEyebrow} title={s.faq.titlePrefix} italic={s.faq.titleHighlight} subtitle={s.faq.subtitle} />
      </div>
      <div class="lg:col-span-8">
        <Preguntes items={d.faqs} group="faq-audio" schema />
      </div>
    </div>
  </section>

  <Crida title={d.cta.title} italic="" subtitle={d.cta.subtitle} message={d.cta.primary} bg="bg-crema-100" />

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "MedicalBusiness",
      "@id": canonical + "#audiologia",
      name: s.schema.businessName,
      description: d.seo.description,
      url: canonical,
      telephone: contactData.contactInfo.phone.display.replace(/\s+/g, "").replace(/^\+34/, "+34 "),
      email: contactData.contactInfo.email.address,
      address: {
        "@type": "PostalAddress",
        streetAddress: contactData.contactInfo.address.street,
        addressLocality: "Barcelona",
        addressRegion: s.schema.addressRegion,
        postalCode: "08030",
        addressCountry: "ES",
      },
      geo: { "@type": "GeoCoordinates", latitude: 41.4372, longitude: 2.1896 },
      areaServed: [
        { "@type": "City", name: "Barcelona" },
        { "@type": "City", name: "Sant Andreu" },
      ],
      hasMap: contactData.contactInfo.address.googleMaps,
      priceRange: "€€-€€€",
      openingHoursSpecification: [
        { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], opens: "09:30", closes: "13:30" },
        { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], opens: "17:00", closes: "20:30" },
        { "@type": "OpeningHoursSpecification", dayOfWeek: "Saturday", opens: "10:00", closes: "13:30" },
      ],
      medicalSpecialty: "Audiología",
    })}
  />
</Layout>
