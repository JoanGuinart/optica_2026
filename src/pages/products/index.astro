---
import Layout from "@layouts/Layout.astro";
import Titol from "@components/ui/Titol.astro";
import Icon from "@components/ui/Icon.astro";
import Etiquetes from "@components/ui/Etiquetes.astro";
import Crida from "@components/ui/Crida.astro";
import { getLocaleFromPath, getLocalizedData, localizePath } from "@/utils/i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const offersData = getLocalizedData<any>(locale, "offers-products");
const d = getLocalizedData<any>(locale, "products");
const comu = getLocalizedData<any>(locale, "site").comu;
const cat = comu.catalog;
const wa = getLocalizedData<any>(locale, "contact").contactInfo.phone.whatsapp;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString();
const waLink = (text: string) => `https://wa.me/${wa}?text=${encodeURIComponent(text)}`;

const principal = {
  badge: offersData.principal?.badge || d.hero.badge?.text,
  title: offersData.principal?.title || `${d.hero.title.main} ${d.hero.title.highlight}`,
  description: offersData.principal?.description || d.hero.description,
  link: offersData.principal?.link,
};
const [titleFirst, ...titleRest] = principal.title.split(" ");

// Promocions: el text fix (botó, condicions) ve de products.json
const promos = (offersData.offers || []).filter(Boolean).map((o: any, i: number) => {
  const cfg = d.specialOffers.offers[i] || {};
  const isAudio = /audi/i.test(o.title);
  return {
    badge: o.badge,
    title: o.title,
    description: cfg.details || o.description,
    price: o.price_or_gift,
    note: cfg.conditions || o.conditions,
    cta: cfg.buttonText,
    href: isAudio ? localizePath("/audifonos-barcelona", locale) : waLink(`${cat.ask}: ${o.title}`),
    external: !isAudio,
  };
});
const products: any[] = d.featuredProducts.products;
---

<Layout title={d.seo?.title} description={d.seo?.description} ogImage={d.seo?.ogImage}>
  <!-- Producte protagonista -->
  <section class="paper relative overflow-hidden bg-crema-100" data-hero>
    <div class="contenidor grid items-center gap-12 py-14 sm:py-20 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="avantitol flex items-center gap-3" data-reveal>
          <span class="inline-block h-px w-8 bg-bosc-600"></span>{principal.badge}
        </p>
        <h1 class="mt-6" style="font-size: clamp(2.8rem, 6.4vw, 5.8rem); letter-spacing: -0.025em; line-height: 1" data-split>
          {titleFirst} <span class="cursiva block" style="font-weight:380">{titleRest.join(" ")}</span>
        </h1>
        <p class="mt-7 max-w-xl text-lg text-tinta-suau sm:text-xl" data-reveal>{principal.description}</p>
        <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4" data-reveal>
          <a href={waLink(`${cat.ask}: ${principal.title}`)} target="_blank" rel="noopener noreferrer" class="boto boto-primari">
            <Icon name="whatsapp" size={20} /> {d.hero.buttons[0]?.text}
          </a>
          {principal.link && (
            <a href={principal.link} target="_blank" rel="noopener noreferrer" class="enllac">
              {cat.demo} <Icon name="fletxa-diag" size={16} />
            </a>
          )}
        </div>
      </div>
      <div class="relative lg:col-span-6">
        <div class="relative mx-auto aspect-square w-full max-w-lg">
          <span class="absolute inset-[6%] rounded-full bg-crema-200" aria-hidden="true"></span>
          <span class="absolute inset-0 rounded-full border border-bosc-700/15" aria-hidden="true"></span>
          <img
            src="/productos/rayban-meta.webp"
            alt={d.hero.imageAlt}
            width="600"
            height="600"
            fetchpriority="high"
            class="flota relative h-full w-full object-contain p-[8%] mix-blend-multiply"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Catàleg amb cercador -->
  <section class="bg-crema-50 py-24 sm:py-28">
    <div class="contenidor">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <Titol eyebrow={cat.eyebrow} title={d.featuredProducts.title.main} italic={d.featuredProducts.title.highlight} subtitle={d.featuredProducts.subtitle} />
        <label class="relative block w-full max-w-sm" data-reveal>
          <span class="sr-only">{cat.search}</span>
          <svg class="pointer-events-none absolute top-1/2 left-0 h-5 w-5 -translate-y-1/2 text-bosc-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.25"></circle><path d="m15.25 15.25 5 5"></path></svg>
          <input
            id="cerca"
            type="search"
            placeholder={cat.search}
            autocomplete="off"
            class="w-full border-0 border-b border-bosc-900/20 bg-transparent py-3 pl-8 text-lg placeholder:text-tinta-suau/60 focus:border-bosc-700 focus:ring-0 focus:outline-none"
          />
        </label>
      </div>

      <ul id="cataleg" class="mt-14 grid grid-cols-1 gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" data-reveal-stagger>
        {products.map((p) => (
          <li data-cerca={`${p.name} ${p.description}`.toLowerCase()}>
            <article class="group flex h-full flex-col">
              <div class="relative aspect-[4/5] overflow-hidden rounded-[1.75rem] bg-crema-100">
                <span class="absolute inset-x-[12%] top-1/2 aspect-square -translate-y-1/2 rounded-full bg-crema-200/70 transition-transform duration-700 ease-out-soft group-hover:scale-110" aria-hidden="true"></span>
                <img
                  src={p.src}
                  alt={`${p.name} – Òptica Guinart Sant Andreu`}
                  width="400"
                  height="400"
                  loading="lazy"
                  decoding="async"
                  class="relative h-full w-full object-contain p-6 mix-blend-multiply transition-transform duration-700 ease-out-soft group-hover:-rotate-3 group-hover:scale-105"
                />
                {p.price && (
                  <span class="absolute top-4 right-4 rounded-full bg-crema-50 px-3 py-1 font-display text-lg text-bosc-900" style="font-weight:560">{p.price}</span>
                )}
              </div>
              <h3 class="mt-5 text-2xl">{p.name}</h3>
              <p class="mt-2 line-clamp-2 text-[0.95rem] text-tinta-suau">{p.description}</p>
              <a href={waLink(`${cat.ask}: ${p.name}`)} target="_blank" rel="noopener noreferrer" class="enllac mt-4 self-start text-[0.95rem]">
                {p.buttonText} <Icon name="fletxa" size={16} />
              </a>
            </article>
          </li>
        ))}
      </ul>
      <p id="cap-resultat" class="mt-10 hidden max-w-xl text-lg text-tinta-suau">{cat.empty}</p>
    </div>
  </section>

  <!-- Promocions -->
  <section class="paper overflow-hidden bg-crema-100 py-24 sm:py-28">
    <div class="contenidor">
      <Titol eyebrow={cat.offersEyebrow} title={d.specialOffers.title.main} italic={d.specialOffers.title.highlight} subtitle={d.specialOffers.subtitle} />
      <div class="mt-16">
        <Etiquetes items={promos} />
      </div>
    </div>
  </section>

  <div class="h-24 bg-crema-50 sm:h-28"></div>
  <Crida title={d.contact.title.main} italic={d.contact.title.highlight} subtitle={d.contact.subtitle} />

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": products.map((p: any) => {
        const m = typeof p.price === "string" ? p.price.replace(/\./g, "").match(/(\d+)/) : null;
        return {
          "@type": "Product",
          name: p.name,
          description: p.description,
          image: Astro.site ? new URL(p.src, Astro.site).toString() : p.src,
          ...(m
            ? { offers: { "@type": "Offer", priceCurrency: "EUR", price: m[1], availability: "https://schema.org/InStoreOnly", url: canonical } }
            : {}),
        };
      }),
    })}
  />
</Layout>

<style>
  .flota {
    animation: flota 6s ease-in-out infinite;
  }
  @keyframes flota {
    50% {
      transform: translateY(-14px) rotate(-2deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .flota {
      animation: none;
    }
  }
</style>

<script>
  // Cercador del catàleg (també respon a /products?q=...)
  const input = document.getElementById("cerca") as HTMLInputElement | null;
  const items = Array.from(document.querySelectorAll<HTMLElement>("#cataleg > li"));
  const empty = document.getElementById("cap-resultat");
  const norm = (s: string) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
  const filtra = () => {
    const q = norm(input?.value.trim() ?? "");
    let visibles = 0;
    items.forEach((li) => {
      const ok = !q || norm(li.dataset.cerca ?? "").includes(q);
      li.hidden = !ok;
      if (ok) visibles++;
    });
    empty?.classList.toggle("hidden", visibles > 0);
  };
  if (input) {
    const q = new URLSearchParams(location.search).get("q");
    if (q) input.value = q;
    input.addEventListener("input", filtra);
    filtra();
  }
</script>
