---
import Layout from "@layouts/Layout.astro";
import CapPagina from "@components/ui/CapPagina.astro";
import Titol from "@components/ui/Titol.astro";
import Icon from "@components/ui/Icon.astro";
import Preguntes from "@components/ui/Preguntes.astro";
import Crida from "@components/ui/Crida.astro";
import { getLocaleFromPath, getLocalizedData } from "@/utils/i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const contactData = getLocalizedData<any>(locale, "contact");
const d = getLocalizedData<any>(locale, "audifonos-barcelona");
const comu = getLocalizedData<any>(locale, "site").comu;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString();
const s = d.sections;
const tipusIcons = ["orella", "bateria", "bluetooth", "ones"];
---

<Layout title={d.seo.title} description={d.seo.description} ogImage={d.seo.ogImage}>
  <CapPagina eyebrow={d.hero.badge} title={d.hero.title.main} italic={d.hero.title.highlight} subtitle={d.hero.subtitle}>
    <ul class="mt-9 flex flex-wrap gap-2" data-reveal-stagger>
      {d.benefits.map((b: string) => (
        <li class="inline-flex items-center gap-2 rounded-full border border-bosc-700/15 bg-crema-50 px-4 py-2 text-sm font-medium">
          <Icon name="check" size={18} class="text-bosc-600" />
          {b}
        </li>
      ))}
    </ul>
  </CapPagina>

  <!-- Tipus d'audiòfons -->
  <section class="bg-crema-50 py-24 sm:py-28">
    <div class="contenidor">
      <Titol title={s.tipos.title} subtitle={s.tipos.subtitle} />
      <ul class="mt-14 grid gap-5 md:grid-cols-2" data-reveal-stagger>
        {d.tipos.map((t: any, i: number) => (
          <li class="group relative overflow-hidden rounded-[1.75rem] bg-crema-100 p-8 transition-colors duration-500 hover:bg-bosc-800 sm:p-10">
            <div class="flex items-start justify-between gap-6">
              <Icon name={tipusIcons[i] ?? "audifon"} size={40} class="text-bosc-600 transition-colors duration-500 group-hover:text-fusta-300" />
              <span class="font-display text-2xl text-fusta-500 italic" style="font-weight:300">0{i + 1}</span>
            </div>
            <h3 class="mt-8 text-3xl transition-colors duration-500 group-hover:!text-crema-50">{t.nombre}</h3>
            <p class="mt-3 text-tinta-suau transition-colors duration-500 group-hover:text-crema-200">{t.desc}</p>
            <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium text-bosc-700 transition-colors duration-500 group-hover:text-fusta-300">
              {t.beneficios.map((b: string) => (
                <li class="inline-flex items-center gap-1.5"><Icon name="check" size={16} /> {b}</li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Procés d'adaptació: línia de temps -->
  <section class="relative overflow-hidden bg-bosc-900 py-24 text-crema-100 sm:py-28">
    <div class="contenidor">
      <Titol title={s.proceso.title} subtitle={s.proceso.subtitle} dark />
      <ol class="relative mt-16 grid gap-10 lg:grid-cols-5 lg:gap-6" data-reveal-stagger>
        <span class="absolute top-6 right-0 left-0 hidden h-px bg-crema-50/15 lg:block" aria-hidden="true"></span>
        <span class="absolute top-0 bottom-0 left-6 w-px bg-crema-50/15 lg:hidden" aria-hidden="true"></span>
        {d.proceso.map((p: any) => (
          <li class="relative pl-20 lg:pl-0">
            <span class="absolute top-0 left-0 inline-flex h-12 w-12 items-center justify-center rounded-full border border-fusta-300/50 bg-bosc-900 font-display text-xl text-fusta-300 lg:relative">
              {p.paso}
            </span>
            <h3 class="text-2xl !text-crema-50 lg:mt-8">{p.titulo}</h3>
            <p class="mt-3 text-crema-200">{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-crema-100 py-24 sm:py-28">
    <div class="contenidor grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <Titol eyebrow={comu.faqEyebrow} title={s.faqs.title} subtitle={s.faqs.subtitle} />
      </div>
      <div class="lg:col-span-8">
        <Preguntes items={d.faqs} group="faq-audifons" schema />
      </div>
    </div>
  </section>

  <Crida title={d.cta.title} italic="" subtitle={d.cta.subtitle} message={d.cta.primary} bg="bg-crema-100" />

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "MedicalBusiness",
      "@id": canonical + "#audifonos",
      name: locale === "ca" ? "Audiòfons Barcelona - Òptica Guinart" : "Audífonos Barcelona - Óptica Guinart",
      description: d.seo.description,
      url: canonical,
      telephone: contactData.contactInfo.phone.display.replace(/\s+/g, "").replace(/^\+34/, "+34 "),
      address: {
        "@type": "PostalAddress",
        streetAddress: contactData.contactInfo.address.street,
        addressLocality: "Barcelona",
        postalCode: "08030",
        addressCountry: "ES",
      },
      areaServed: [
        { "@type": "City", name: "Barcelona" },
        { "@type": "City", name: "Sant Andreu" },
      ],
      hasMap: contactData.contactInfo.address.googleMaps,
      medicalSpecialty: "Audiología",
      openingHoursSpecification: [
        { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], opens: "09:30", closes: "13:30" },
        { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], opens: "17:00", closes: "20:30" },
        { "@type": "OpeningHoursSpecification", dayOfWeek: "Saturday", opens: "10:00", closes: "13:30" },
      ],
      makesOffer: {
        "@type": "AggregateOffer",
        lowPrice: 600,
        highPrice: 2500,
        priceCurrency: "EUR",
      },
    })}
  />
</Layout>
