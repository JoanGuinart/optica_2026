---
import Layout from "@layouts/Layout.astro";
import CapPagina from "@components/ui/CapPagina.astro";
import Icon from "@components/ui/Icon.astro";
import Preguntes from "@components/ui/Preguntes.astro";
import Crida from "@components/ui/Crida.astro";
import { getLocaleFromPath, getLocalizedData } from "@/utils/i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const d = getLocalizedData<any>(locale, "faq");
const comu = getLocalizedData<any>(locale, "site").comu;
const titles = d.page.sections;

const toItems = (arr: any[]) => arr.map((f) => ({ q: f.question, a: f.answer }));
const groups = [
  { id: "optica", icon: "ulleres", title: titles.optica, items: toItems(d.optica) },
  { id: "audiometria", icon: "orella", title: titles.audiometria, items: toItems(d.audiometria) },
  { id: "general", icon: "xat", title: titles.general, items: toItems(d.general) },
];
const words = d.page.title.split(" ");
---

<Layout title={d.seo?.title} description={d.seo?.description} ogImage={d.seo?.ogImage}>
  <CapPagina
    eyebrow={comu.faqEyebrow}
    title={words.slice(0, -1).join(" ") || d.page.title}
    italic={words.length > 1 ? words.at(-1) : undefined}
    subtitle={d.page.subtitle}
    ctas={false}
  />

  <section class="bg-crema-50 py-20 sm:py-24">
    <div class="contenidor grid gap-12 lg:grid-cols-12">
      <!-- Índex lateral (fix en escriptori) -->
      <nav class="min-w-0 lg:col-span-3" aria-label={d.page.title}>
        <ul class="flex gap-2 overflow-x-auto pb-2 lg:sticky lg:top-28 lg:flex-col lg:gap-1 lg:overflow-visible">
          {groups.map((g) => (
            <li class="shrink-0">
              <a href={`#${g.id}`} class="flex items-center gap-3 rounded-full px-4 py-2.5 text-sm font-semibold text-tinta-suau transition-colors hover:bg-crema-100 hover:text-bosc-700 lg:text-base">
                <Icon name={g.icon} size={20} class="text-bosc-600" />
                {g.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="min-w-0 space-y-20 lg:col-span-9">
        {groups.map((g) => (
          <div id={g.id} class="scroll-mt-28">
            <h2 class="mb-6 flex items-center gap-4" style="font-size: clamp(1.9rem, 3.4vw, 2.8rem)" data-reveal>
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-crema-100 text-bosc-700">
                <Icon name={g.icon} size={24} />
              </span>
              {g.title}
            </h2>
            <Preguntes items={g.items} group={`faq-${g.id}`} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <Crida title={d.page.cta.noAnswerTitle} italic="" subtitle={d.page.cta.noAnswerText} />

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: groups.flatMap((g) =>
        g.items.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
      ),
    })}
  />
</Layout>
