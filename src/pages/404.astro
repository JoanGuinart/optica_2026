---
import Layout from "@layouts/Layout.astro";
import Icon from "@components/ui/Icon.astro";
import { getLocalizedData } from "@/utils/i18n";

const ca = getLocalizedData<any>("ca", "site").comu.notFound;
const es = getLocalizedData<any>("es", "site").comu.notFound;
---

<Layout title="404 · Òptica Guinart" noindex>
  <section class="paper flex min-h-[80svh] items-center bg-crema-100">
    <div class="contenidor grid items-center gap-12 py-16 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="avantitol">Error 404</p>
        <h1 class="mt-6" style="font-size: clamp(2.6rem, 6vw, 5.2rem); line-height: 1">
          {ca.title} <span class="cursiva block" style="font-weight:380">{ca.italic}</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-tinta-suau">{ca.text}</p>
        <p class="mt-2 max-w-xl text-tinta-suau/80 italic" lang="es">{es.text}</p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a href="/" class="boto boto-primari">{ca.back} <Icon name="fletxa" size={18} class="fletxa" /></a>
          <a href="/es/" class="boto boto-linia" lang="es">{es.back}</a>
        </div>
      </div>
      <!-- "404" desenfocat que s'enfoca en passar-hi per sobre, com en una revisió de la vista -->
      <div class="enfoca relative mx-auto flex aspect-square w-full max-w-sm items-center justify-center rounded-full border-[14px] border-bosc-700 bg-crema-50 lg:col-span-5" aria-hidden="true">
        <span class="font-display text-[clamp(4rem,10vw,7rem)] text-bosc-900" style="font-weight:650">404</span>
        <span class="absolute top-[14%] right-[18%] h-[22%] w-[10%] rotate-[35deg] rounded-full border-r-[5px] border-fusta-400"></span>
      </div>
    </div>
  </section>
</Layout>

<style>
  .enfoca span:first-child {
    filter: blur(7px);
    transition: filter 0.9s var(--ease-out-soft);
  }
  .enfoca:hover span:first-child {
    filter: blur(0);
  }
  @media (hover: none) {
    .enfoca span:first-child {
      animation: enfoca 3s var(--ease-out-soft) 0.5s forwards;
    }
  }
  @keyframes enfoca {
    to {
      filter: blur(0);
    }
  }
</style>
