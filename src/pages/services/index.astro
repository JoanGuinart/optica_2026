---
import Layout from "@layouts/Layout.astro";
import CapPagina from "@components/ui/CapPagina.astro";
import Titol from "@components/ui/Titol.astro";
import Icon from "@components/ui/Icon.astro";
import Crida from "@components/ui/Crida.astro";
import { getLocaleFromPath, getLocalizedData, localizePath } from "@/utils/i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const d = getLocalizedData<any>(locale, "services");
const contactData = getLocalizedData<any>(locale, "contact");
const ui = getLocalizedData<any>(locale, "ui");
const wa = contactData.contactInfo.phone.whatsapp;
const askText = (title: string) =>
  locale === "ca" ? `Hola! Voldria informació sobre: ${title}` : `¡Hola! Quisiera información sobre: ${title}`;

const services: { title: string; description: string; icon: string; price?: string; duration?: string; features?: string[] }[] =
  d.services;
---

<Layout title={d.seo?.title} description={d.seo?.description} ogImage={d.seo?.ogImage}>
  <CapPagina eyebrow={d.hero.badge.text} title={d.hero.title.main} italic={d.hero.title.highlight} subtitle={d.hero.subtitle} />

  <!-- Llista de serveis -->
  <section class="bg-crema-50 py-20 sm:py-24">
    <div class="contenidor">
      <h2 class="sr-only">{d.intro.sectionTitle}</h2>
      <ol class="border-t border-bosc-900/10" data-reveal-stagger>
        {services.map((sv, i) => (
          <li class="servei group grid gap-5 border-b border-bosc-900/10 py-10 sm:grid-cols-12 sm:items-center sm:gap-8">
            <div class="flex items-center gap-5 sm:col-span-4">
              <span class="font-display text-2xl text-fusta-500 italic" style="font-weight:300">0{i + 1}</span>
              <span class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-crema-100 text-bosc-700 transition-colors duration-500 group-hover:bg-bosc-700 group-hover:text-crema-50">
                <Icon name={sv.icon} size={28} />
              </span>
              <h3 class="text-3xl">{sv.title}</h3>
            </div>
            <p class="text-lg text-tinta-suau sm:col-span-5">{sv.description}</p>
            <div class="flex items-center justify-between gap-6 sm:col-span-3 sm:justify-end">
              {sv.price && (
                <span class="rounded-full bg-fusta-300/40 px-3 py-1 font-display text-lg text-bosc-900" style="font-weight:560">
                  {sv.price}
                </span>
              )}
              <a
                href={`https://wa.me/${wa}?text=${encodeURIComponent(askText(sv.title))}`}
                target="_blank"
                rel="noopener noreferrer"
                class="enllac whitespace-nowrap"
              >
                {ui.cta.saberMas} <Icon name="fletxa" size={16} />
              </a>
            </div>
          </li>
        ))}
      </ol>
      <div class="mt-6 space-y-1 text-sm text-tinta-suau">
        <p>{d.notes.free}</p>
        <p>{d.notes.included}</p>
      </div>
    </div>
  </section>

  <!-- Enllaços a les pàgines especialitzades -->
  <section class="bg-crema-100 py-20 sm:py-24">
    <div class="contenidor grid gap-5 md:grid-cols-3" data-reveal-stagger>
      {d.intro.blocks.map((b: any) => (
        <a href={localizePath(b.path, locale)} class="group flex flex-col justify-between gap-10 rounded-[1.75rem] bg-crema-50 p-8 transition-colors duration-500 hover:bg-bosc-800">
          <p class="text-tinta-suau transition-colors duration-500 group-hover:text-crema-200">{b.prefix}<strong class="font-semibold text-bosc-800 group-hover:text-crema-50">{b.linkText}</strong>{b.suffix}</p>
          <span class="inline-flex h-12 w-12 items-center justify-center self-end rounded-full border border-bosc-700/20 text-bosc-700 transition-all duration-500 group-hover:-rotate-45 group-hover:border-fusta-300 group-hover:text-fusta-300">
            <Icon name="fletxa" size={20} />
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Per què nosaltres -->
  <section class="bg-bosc-900 py-24 text-crema-100 sm:py-28">
    <div class="contenidor">
      <Titol title={d.benefits.title} dark />
      <ul class="mt-14 grid gap-10 md:grid-cols-3 md:gap-8" data-reveal-stagger>
        {d.benefits.items.map((it: any) => (
          <li class="border-t border-crema-50/15 pt-8">
            <Icon name={it.icon} size={34} class="text-fusta-300" />
            <h3 class="mt-5 text-2xl !text-crema-50">{it.title}</h3>
            <p class="mt-3 text-crema-200">{it.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="h-24 bg-crema-50 sm:h-28"></div>
  <Crida title={d.cta.title} italic="" subtitle={d.cta.subtitle} />

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": services.map((s) => {
        const m = typeof s.price === "string" ? s.price.match(/(\d+)/) : null;
        return {
          "@type": "Service",
          name: s.title,
          description: s.description,
          provider: {
            "@type": "LocalBusiness",
            name: "Òptica Guinart",
            address: {
              "@type": "PostalAddress",
              streetAddress: contactData.contactInfo.address.street,
              addressLocality: "Barcelona",
              postalCode: "08030",
              addressCountry: "ES",
            },
            telephone: contactData.contactInfo.phone.display,
          },
          areaServed: { "@type": "City", name: "Barcelona" },
          ...(m ? { offers: { "@type": "Offer", price: m[1], priceCurrency: "EUR", availability: "https://schema.org/InStoreOnly" } } : {}),
        };
      }),
    })}
  />
</Layout>
