---
import { Picture } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import CapPagina from "@components/ui/CapPagina.astro";
import Titol from "@components/ui/Titol.astro";
import Icon from "@components/ui/Icon.astro";
import Preguntes from "@components/ui/Preguntes.astro";
import OnSom from "@components/ui/OnSom.astro";
import Crida from "@components/ui/Crida.astro";
import { getLocaleFromPath, getLocalizedData } from "@/utils/i18n";
import facana from "@assets/fotos/rotul-entrada.webp";
import botiga from "@assets/fotos/interior-botiga.webp";

const locale = getLocaleFromPath(Astro.url.pathname);
const d = getLocalizedData<any>(locale, "optica-sant-andreu");
const contactData = getLocalizedData<any>(locale, "contact");
const comu = getLocalizedData<any>(locale, "site").comu;
const inici = getLocalizedData<any>(locale, "inici");
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString();

// Les respostes d'adreça i horari surten de les dades de contacte (una sola font)
const faqs = d.faqs.map((f: any, i: number) => {
  if (i === 0) return { ...f, a: `${contactData.contactInfo.address.street}, Barcelona` };
  if (i === 1) return { ...f, a: `${contactData.contactInfo.hours.weekdays}. ${contactData.contactInfo.hours.saturday}.` };
  return f;
});
const serviceIcons = ["ull", "ulleres", "lentilla", "audifon"];
---

<Layout title={d.seo.title} description={d.seo.description} ogImage={d.seo.ogImage}>
  <CapPagina
    eyebrow={d.hero.badge}
    title={`${d.hero.title.main} ${d.hero.title.highlight}`}
    italic={d.hero.title.suffix.trim()}
    subtitle={d.hero.subtitle}
    image={facana}
    imageAlt={inici.hero.photoAlt}
    imagePosition="100% 0%"
  />

  <section class="bg-crema-50 py-24 sm:py-28">
    <div class="contenidor grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <Titol eyebrow={inici.services.eyebrow} title={d.sections.servicesTitle} />
        <ul class="mt-12 divide-y divide-bosc-900/10 border-y border-bosc-900/10" data-reveal-stagger>
          {d.services.map((sv: any, i: number) => (
            <li class="flex gap-5 py-7">
              <Icon name={serviceIcons[i] ?? "ull"} size={30} class="mt-1 shrink-0 text-bosc-600" />
              <div>
                <h3 class="text-2xl">{sv.title}</h3>
                <p class="mt-2 text-tinta-suau">{sv.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-6">
        <div class="relative h-full min-h-[22rem] overflow-hidden rounded-[2rem] bg-crema-200" data-lent>
          <Picture
            src={botiga}
            alt={inici.services.blocks[0].photoAlt}
            formats={["avif", "webp"]}
            widths={[500, 900]}
            sizes="(min-width: 1024px) 45vw, 100vw"
            class="absolute inset-x-0 -top-[8%] h-[116%] w-full object-cover"
            pictureAttributes={{ class: "contents" }}
            style="object-position: 40% 60%"
            data-parallax="0.12"
          />
        </div>
      </div>
    </div>
  </section>

  <OnSom title={d.sections.napTitle} italic="" />

  <section class="bg-crema-100 py-24 sm:py-28">
    <div class="contenidor grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <Titol eyebrow={comu.faqEyebrow} title={d.sections.faqTitle} />
      </div>
      <div class="lg:col-span-8">
        <Preguntes items={faqs} group="faq-optica" schema />
      </div>
    </div>
  </section>

  <Crida bg="bg-crema-100" />

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      name: locale === "ca" ? "Òptica a Sant Andreu (Barcelona)" : "Óptica en Sant Andreu (Barcelona)",
      provider: {
        "@type": "Optician",
        name: "Òptica y Audiología Guinart",
        telephone: contactData.contactInfo.phone.display.replace(/\s+/g, "").replace(/^\+34/, "+34 "),
        address: {
          "@type": "PostalAddress",
          streetAddress: contactData.contactInfo.address.street,
          addressLocality: "Barcelona",
          postalCode: "08030",
          addressCountry: "ES",
        },
        areaServed: { "@type": "City", name: "Barcelona" },
      },
      areaServed: "Sant Andreu, Barcelona",
      url: canonical,
    })}
  />
</Layout>
