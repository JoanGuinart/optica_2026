---
// Botó flotant de WhatsApp (només mòbil)
import Icon from "@components/ui/Icon.astro";
import { getLocaleFromPath, getLocalizedData } from "@/utils/i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const contact = getLocalizedData<any>(locale, "contact");
---

<a
  href={contact.socialMedia.whatsapp.url}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed right-4 bottom-4 z-40 inline-flex h-14 w-14 items-center justify-center rounded-full bg-bosc-700 text-crema-50 shadow-[0_12px_30px_-10px_rgba(13,36,26,0.6)] transition-transform duration-300 active:scale-95 md:hidden"
  style="margin-bottom: env(safe-area-inset-bottom)"
  aria-label={contact.socialMedia.whatsapp.text}
>
  <Icon name="whatsapp" size={28} />
</a>
