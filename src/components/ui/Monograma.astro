---
/**
 * Monograma: la "Ò" del rètol convertida en una lent.
 * L'anell és la muntura/lent, l'accent greu és el de "Òptica"
 * i el petit arc daurat és el reflex de llum sobre el vidre.
 */
interface Props {
  class?: string;
  /** color de l'anell i l'accent (per defecte, el verd del rètol) */
  tone?: "bosc" | "crema";
}
const { class: className = "", tone = "bosc" } = Astro.props;
const toneClass = tone === "bosc" ? "text-bosc-700" : "text-crema-50";
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 40 48"
  class={`${toneClass} ${className}`}
  aria-hidden="true"
  focusable="false"
>
  <path d="M10.6 2.6 17.4.9l7.4 10.3-3.6 1.6Z" fill="currentColor"></path>
  <circle cx="20" cy="30" r="13.25" fill="none" stroke="currentColor" stroke-width="5.5"></circle>
  <path
    d="M25.6 22.9a9.3 9.3 0 0 1 3.4 5.6"
    fill="none"
    style="stroke: var(--color-fusta-400)"
    stroke-width="2.4"
    stroke-linecap="round"></path>
</svg>
