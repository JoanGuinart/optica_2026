  telefon: `<path d="M8.4 3.75H5.6a1.85 1.85 0 0 0-1.85 2C4.4 14.1 9.9 19.6 18.25 20.25a1.85 1.85 0 0 0 2-1.85v-2.8l-3.7-1.5-2 2a11.6 11.6 0 0 1-4.65-4.65l2-2Z"/>`,
