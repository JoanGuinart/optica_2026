---
/**
 * Icones pròpies d'Òptica Guinart.
 * Dibuixades en una graella de 24px, traç d'1.5px, extrems arrodonits.
 * Totes comparteixen el mateix pes perquè es vegin com una família.
 */
export type IconName =
  | "ulleres"
  | "ull"
  | "lentilla"
  | "audifon"
  | "orella"
  | "sol"
  | "rellotge"
  | "ubicacio"
  | "telefon"
  | "correu"
  | "whatsapp"
  | "instagram"
  | "facebook"
  | "estrella"
  | "fletxa"
  | "fletxa-diag"
  | "check"
  | "menu"
  | "tancar"
  | "pressio"
  | "eina"
  | "escut"
  | "medalla"
  | "xat"
  | "cor"
  | "persona"
  | "enviar"
  | "precisio"
  | "calendari"
  | "ones"
  | "bateria"
  | "bluetooth"
  | "mes"
  | "aigua";

/** Noms antics que encara fan servir els JSON */
const aliases: Record<string, IconName> = {
  eye: "ull",
  contact: "lentilla",
  pressure: "pressio",
  ear: "orella",
  wrench: "eina",
  technology: "precisio",
  award: "medalla",
  certificate: "medalla",
  shield: "escut",
  chat: "xat",
  message: "xat",
  heart: "cor",
  user: "persona",
  send: "enviar",
  clock: "rellotge",
  location: "ubicacio",
  phone: "telefon",
  mail: "correu",
  email: "correu",
  star: "estrella",
  google: "estrella",
};

interface Props {
  name: IconName | keyof typeof aliases | (string & {});
  class?: string;
  size?: number;
  label?: string;
}

const { name: rawName, class: className = "", size = 24, label } = Astro.props;
const name: IconName = (aliases[rawName] ?? rawName) as IconName;

const icons: Record<IconName, string> = {
  // Muntura rodona, pont i patilles
