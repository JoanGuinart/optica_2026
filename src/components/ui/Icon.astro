  enviar: `<path d="M20.75 3.25 10.5 13.5M20.75 3.25 14.5 20.75l-4-7.25-7.25-4Z"/>`,
  precisio: `<circle cx="12" cy="12" r="7.75"/><circle cx="12" cy="12" r="3"/><path d="M12 2.5V6M12 18v3.5M2.5 12H6M18 12h3.5"/>`,
  calendari: `<rect x="3.75" y="5" width="16.5" height="15.25" rx="2"/><path d="M3.75 9.75h16.5M8 3v4M16 3v4M8 13.5h.01M12 13.5h.01M16 13.5h.01M8 17h.01M12 17h.01"/>`,
