  facebook: `<path d="M14.5 21v-7.25h2.6l.4-3h-3V8.9c0-.85.3-1.45 1.5-1.45h1.6V4.8a20 20 0 0 0-2.35-.12c-2.35 0-3.95 1.4-3.95 4.05v2.02H8.7v3h2.6V21"/>`,
  estrella: `<path d="m12 3.6 2.55 5.35 5.85.75-4.3 4.05 1.1 5.8L12 16.7l-5.2 2.85 1.1-5.8-4.3-4.05 5.85-.75Z"/>`,
