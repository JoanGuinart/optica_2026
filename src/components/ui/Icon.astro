  // Tornavís d'ulleres i clau
  eina: `<path d="M14.25 4.4a4.4 4.4 0 0 0-1.2 4.8l-8 8a1.85 1.85 0 0 0 2.6 2.6l8-8a4.4 4.4 0 0 0 4.8-1.2l-2.7-.5-.55-2.7Z"/>`,
  escut: `<path d="M12 3.25 5 6v5.6c0 4.25 2.95 7.5 7 9.15 4.05-1.65 7-4.9 7-9.15V6Z"/><path d="m9 12 2.1 2.1L15.25 10"/>`,
  medalla: `<circle cx="12" cy="9.25" r="5.25"/><path d="M8.75 13.4 7.6 20.75 12 18.6l4.4 2.15-1.15-7.35"/><path d="m10.4 9.3 1.1 1.1 2.2-2.2"/>`,
  xat: `<path d="M20.25 11.25c0 3.9-3.7 7-8.25 7-1.05 0-2.05-.15-2.95-.45L4.5 19.5l1.35-3.6a6.6 6.6 0 0 1-2.1-4.65c0-3.9 3.7-7 8.25-7s8.25 3.1 8.25 7Z"/><path d="M8.5 11.25h.01M12 11.25h.01M15.5 11.25h.01"/>`,
