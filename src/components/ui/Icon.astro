  ull: `<path d="M2.5 12S6 5.75 12 5.75 21.5 12 21.5 12 18 18.25 12 18.25 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="3.25"/><path d="M13.1 10.6a1.4 1.4 0 0 1 .5.7"/>`,
  // Lent de contacte sobre la punta del dit
  lentilla: `<path d="M4.5 14.5C4.5 9.8 7.9 6.5 12 6.5s7.5 3.3 7.5 8"/><path d="M4.5 14.5c2.1 1.2 4.6 1.75 7.5 1.75s5.4-.55 7.5-1.75"/><path d="M8.6 10.1c.8-.95 1.95-1.5 3.4-1.6"/><path d="M8 19.5c1.2.5 2.5.75 4 .75s2.8-.25 4-.75"/>`,
  // Audiòfon retroauricular amb tub i olivari
  audifon: `<path d="M13 3.75c3.3 0 5.5 2.3 5.5 5.4v2.35c0 2.6-1.7 4.25-3.9 4.25"/><path d="M13 3.75c-1.5 0-2.5 1-2.5 2.4v1.1c0 1.2.8 1.95 2 1.95h.6"/><path d="M14.6 15.75c0 2.7-1.9 4.5-4.6 4.5"/><circle cx="8.25" cy="20" r="1.25"/><path d="M15.9 6.6v2.6"/>`,
  // Orella
  orella: `<path d="M7 9.5a5.5 5.5 0 0 1 11 0c0 3.1-2.4 4.1-3.4 5.7-.8 1.3-.8 4.3-3.3 4.3A2.8 2.8 0 0 1 8.5 17"/><path d="M10.5 10a2.25 2.25 0 0 1 4.5 0c0 1.2-1.1 1.6-1.6 2.4"/>`,
  sol: `<circle cx="12" cy="12" r="4"/><path d="M12 2.75v2M12 19.25v2M2.75 12h2M19.25 12h2M5.45 5.45l1.4 1.4M17.15 17.15l1.4 1.4M5.45 18.55l1.4-1.4M17.15 6.85l1.4-1.4"/>`,
