---
/**
 * Capçalera de les pàgines interiors.
 * Text a l'esquerra; a la dreta una foto en arc (si n'hi ha) o la lent decorativa.
 */
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import { getLocaleFromPath, getLocalizedData } from "@/utils/i18n";

interface Props {
  eyebrow?: string;
  title: string;
  italic?: string;
  subtitle?: string;
  ctas?: boolean;
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
}
const { eyebrow, title, italic, subtitle, ctas = true, image, imageAlt = "", imagePosition = "50% 50%" } = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);
const comu = getLocalizedData<any>(locale, "site").comu;
const contact = getLocalizedData<any>(locale, "contact");
const phone = contact.contactInfo.phone.display;
---

<section class="paper relative overflow-hidden bg-crema-100" data-hero>
  <div class={`contenidor relative grid items-center gap-12 py-14 sm:py-20 ${image ? "lg:grid-cols-12" : ""}`}>
    <div class={image ? "lg:col-span-7" : "max-w-4xl"}>
      {eyebrow && (
        <p class="avantitol flex items-center gap-3" data-reveal>
          <span class="inline-block h-px w-8 bg-bosc-600"></span>
          {eyebrow}
        </p>
      )}
      <h1 class="mt-6" style="font-size: clamp(2.6rem, 6vw, 5.5rem); letter-spacing: -0.025em; line-height: 1" data-split>
        {title}
        {italic && <span class="cursiva block" style="font-weight:380">{italic}</span>}
      </h1>
      {subtitle && <p class="mt-7 max-w-2xl text-lg text-tinta-suau sm:text-xl" data-reveal>{subtitle}</p>}
      <slot />
      {ctas && (
        <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4" data-reveal>
          <a href={contact.socialMedia.whatsapp.url} target="_blank" rel="noopener noreferrer" class="boto boto-primari">
            <Icon name="whatsapp" size={20} /> {comu.whatsapp}
          </a>
          <a href={`tel:${phone.replace(/\s+/g, "")}`} class="enllac">
            <Icon name="telefon" size={18} /> {phone}
          </a>
        </div>
      )}
    </div>

    {image ? (
      <div class="relative mx-auto w-full max-w-sm lg:col-span-5 lg:max-w-none">
        <div class="arc-4-5 relative ml-auto aspect-[4/5] w-[85%] overflow-hidden bg-crema-200" data-lent>
          <Picture
            src={image}
            alt={imageAlt}
            formats={["avif", "webp"]}
            widths={[400, 700]}
            sizes="(min-width: 1024px) 34vw, 80vw"
            loading="eager"
            class="h-full w-full"
            pictureAttributes={{ class: "block h-full w-full" }}
            style={`object-fit: cover; object-position: ${imagePosition}; height: 100%; width: 100%`}
          />
        </div>
      </div>
    ) : (
      <svg
        class="pointer-events-none absolute top-1/2 -right-40 hidden h-[34rem] w-[34rem] -translate-y-1/2 text-bosc-700/[0.07] lg:block"
        viewBox="0 0 200 200"
        fill="none"
        stroke="currentColor"
        aria-hidden="true"
        data-parallax="0.2"
      >
        <circle cx="100" cy="100" r="80" stroke-width="18"></circle>
        <path d="M128 52a62 62 0 0 1 20 34" stroke-width="7" stroke-linecap="round" style="stroke: var(--color-fusta-400); opacity: 0.6"></path>
      </svg>
    )}
  </div>
</section>
