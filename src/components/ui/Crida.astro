---
/** Crida final: bloc verd amb WhatsApp i telèfon */
import Icon from "./Icon.astro";
import { getLocaleFromPath, getLocalizedData } from "@/utils/i18n";

interface Props {
  title?: string;
  italic?: string;
  subtitle?: string;
  /** text que arriba ja escrit al WhatsApp */
  message?: string;
  /** color del fons de la secció */
  bg?: string;
}
const locale = getLocaleFromPath(Astro.url.pathname);
const comu = getLocalizedData<any>(locale, "site").comu;
const info = getLocalizedData<any>(locale, "contact").contactInfo;
const { title = comu.closing.title, italic = comu.closing.italic, subtitle, message, bg = "bg-crema-50" } = Astro.props;
const wa = `https://wa.me/${info.phone.whatsapp}${message ? `?text=${encodeURIComponent(message)}` : ""}`;
---

<section class={`${bg} pb-24 sm:pb-28`}>
  <div class="contenidor">
    <div class="relative overflow-hidden rounded-[2rem] bg-bosc-800 px-6 py-16 text-center sm:px-12 sm:py-20">
      <svg class="pointer-events-none absolute -bottom-40 left-1/2 h-[30rem] w-[30rem] -translate-x-1/2 text-crema-50/[0.05]" viewBox="0 0 200 200" fill="none" stroke="currentColor" aria-hidden="true">
        {[40, 60, 80, 98].map((r) => <circle cx="100" cy="100" r={r} stroke-width="1" />)}
      </svg>
      <div class="relative mx-auto max-w-2xl">
        <p class="avantitol !text-fusta-300" data-reveal>{comu.closing.eyebrow}</p>
        <h2 class="mt-5 !text-crema-50" style="font-size: clamp(2.1rem, 4.6vw, 4rem)" data-split>
          {title} {italic && <span class="cursiva !text-fusta-300">{italic}</span>}
        </h2>
        {subtitle && <p class="mt-5 text-lg text-crema-200" data-reveal>{subtitle}</p>}
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-8" data-reveal>
          <a href={wa} target="_blank" rel="noopener noreferrer" class="boto boto-clar">
            <Icon name="whatsapp" size={20} /> {comu.whatsapp}
          </a>
          <a href={`tel:${info.phone.display.replace(/\s+/g, "")}`} class="enllac !text-crema-50">
            <Icon name="telefon" size={18} /> {info.phone.display}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
