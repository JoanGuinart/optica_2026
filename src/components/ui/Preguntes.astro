---
/**
 * Preguntes freqüents desplegables (HTML natiu <details>, sense JS).
 * Inclou les dades estructurades FAQPage si `schema` és cert.
 */
interface Props {
  items: { q: string; a: string }[];
  group?: string;
  schema?: boolean;
}
const { items, group = "faq", schema = false } = Astro.props;
---

<div class="divide-y divide-bosc-900/10 border-y border-bosc-900/10" data-reveal-stagger>
  {items.map((it) => (
    <details name={group} class="pregunta group">
      <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 text-left">
        <h3 class="font-display text-xl leading-snug text-bosc-900 sm:text-2xl" style="font-weight:500">{it.q}</h3>
        <span class="mt-1 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-bosc-700/20 text-bosc-700 transition-[transform,background-color,color] duration-500 ease-out-soft group-open:rotate-45 group-open:bg-bosc-700 group-open:text-crema-50" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
        </span>
      </summary>
      <div class="max-w-3xl pb-7 pr-12 text-lg leading-relaxed text-tinta-suau" set:html={it.a} />
    </details>
  ))}
</div>

{
  schema && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: items.map((it) => ({
          "@type": "Question",
          name: it.q,
          acceptedAnswer: { "@type": "Answer", text: it.a.replace(/<[^>]+>/g, "") },
        })),
      })}
    />
  )
}

<style>
  .pregunta summary::-webkit-details-marker {
    display: none;
  }
  .pregunta summary:hover h3 {
    color: var(--color-bosc-700);
  }
  /* Obertura suau als navegadors que ho suporten */
  @supports (interpolate-size: allow-keywords) {
    .pregunta {
      interpolate-size: allow-keywords;
    }
    .pregunta::details-content {
      height: 0;
      overflow: clip;
      transition:
        height 0.5s var(--ease-out-soft),
        content-visibility 0.5s allow-discrete;
    }
    .pregunta[open]::details-content {
      height: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pregunta::details-content {
      transition: none;
    }
  }
</style>
