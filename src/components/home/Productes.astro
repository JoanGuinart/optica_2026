---
import Icon from "@components/ui/Icon.astro";
import { getLocaleFromPath, getLocalizedData, localizePath } from "@/utils/i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const t = getLocalizedData<any>(locale, "inici").products;
const products: any[] = getLocalizedData<any>(locale, "main-content").featuredProducts.products;
const wa = getLocalizedData<any>(locale, "contact").contactInfo.phone.whatsapp;
const askText = (p: any) =>
  `${locale === "ca" ? "Hola! M'interessa" : "¡Hola! Me interesa"}: ${p.name}`;
---

<section class="bg-crema-50 py-24 sm:py-32">
  <div class="contenidor">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="avantitol" data-reveal>{t.eyebrow}</p>
        <h2 class="mt-5" style="font-size: clamp(2.3rem, 4.8vw, 4.25rem)" data-split>
          {t.title.before} <span class="cursiva">{t.title.italic}</span>
        </h2>
      </div>
      <a href={localizePath("/products", locale)} class="enllac self-start sm:self-auto" data-reveal>
        {t.all} <Icon name="fletxa" size={18} />
      </a>
    </div>
  </div>

  <div class="contenidor mt-14 !pr-0 sm:!pr-8 lg:!pr-12">
    <ul class="rail flex snap-x snap-mandatory gap-5 overflow-x-auto pr-5 pb-4 sm:mr-0 sm:grid sm:grid-cols-2 sm:gap-8 sm:overflow-visible sm:pr-0 lg:grid-cols-4" data-reveal-stagger>
      {products.map((p) => (
        <li class="w-[78%] shrink-0 snap-start sm:w-auto">
          <article class="producte group flex h-full flex-col">
            <div class="relative aspect-[4/5] overflow-hidden rounded-[1.75rem] bg-crema-100">
              <span class="absolute inset-x-[12%] top-1/2 aspect-square -translate-y-1/2 rounded-full bg-crema-200/70 transition-transform duration-700 ease-out-soft group-hover:scale-110" aria-hidden="true"></span>
              <img
                src={p.src}
                alt={`${p.name} – Òptica Guinart Sant Andreu`}
                width="400"
                height="400"
                loading="lazy"
                decoding="async"
                class="relative h-full w-full object-contain p-6 mix-blend-multiply transition-transform duration-700 ease-out-soft group-hover:-rotate-3 group-hover:scale-105"
              />
            </div>
            <h3 class="mt-5 text-2xl">{p.name}</h3>
            <p class="mt-2 line-clamp-2 text-[0.95rem] text-tinta-suau">{p.description}</p>
            <a
              href={`https://wa.me/${wa}?text=${encodeURIComponent(askText(p))}`}
              target="_blank"
              rel="noopener noreferrer"
              class="enllac mt-4 self-start text-[0.95rem]"
            >
              {p.buttonText || t.ask} <Icon name="fletxa" size={16} />
            </a>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .rail {
    scrollbar-width: none;
  }
  .rail::-webkit-scrollbar {
    display: none;
  }
</style>
