---
import { Picture } from "astro:assets";
import Icon from "@components/ui/Icon.astro";
import { getLocaleFromPath, getLocalizedData, localizePath } from "@/utils/i18n";
import botiga from "@assets/fotos/interior-botiga.webp";

const locale = getLocaleFromPath(Astro.url.pathname);
const t = getLocalizedData<any>(locale, "inici").services;
const [optica, audio] = t.blocks;
---

<section class="bg-crema-50 py-24 sm:py-32">
  <div class="contenidor">
    <div class="max-w-3xl">
      <p class="avantitol" data-reveal>{t.eyebrow}</p>
      <h2 class="mt-5" style="font-size: clamp(2.3rem, 4.8vw, 4.25rem)" data-split>
        {t.title.before} <span class="cursiva">{t.title.italic}</span>
      </h2>
    </div>

    <!-- 01 · Òptica: foto gran + llista -->
    <div class="mt-16 grid gap-10 lg:mt-24 lg:grid-cols-12 lg:gap-16">
      <div class="relative lg:col-span-7">
        <div class="relative aspect-[16/11] overflow-hidden rounded-[2rem] bg-crema-200" data-lent>
          <Picture
            src={botiga}
            alt={optica.photoAlt}
            formats={["avif", "webp"]}
            widths={[600, 1000]}
            sizes="(min-width: 1024px) 55vw, 100vw"
            class="absolute inset-x-0 -top-[8%] h-[116%] w-full object-cover"
            pictureAttributes={{ class: "contents" }}
            style="object-position: 55% 60%"
            data-parallax="0.12"
          />
        </div>
      </div>
      <div class="flex flex-col justify-center lg:col-span-5">
        <span class="font-display text-7xl text-fusta-500 italic" style="font-weight:300">{optica.num}</span>
        <h3 class="mt-4 text-5xl sm:text-6xl" data-split>{optica.title}</h3>
        <p class="mt-6 text-lg text-tinta-suau" data-reveal>{optica.text}</p>
        <ul class="mt-8 divide-y divide-bosc-900/10 border-y border-bosc-900/10" data-reveal-stagger>
          {optica.items.map((it: any) => (
            <li class="flex items-center gap-4 py-4 text-lg">
              <Icon name={it.icon} size={26} class="shrink-0 text-bosc-600" />
              {it.label}
            </li>
          ))}
        </ul>
        <a href={localizePath(optica.link.href, locale)} class="enllac mt-8 self-start" data-reveal>
          {optica.link.label} <Icon name="fletxa" size={18} />
        </a>
      </div>
    </div>

    <!-- 02 · Audiologia: bloc verd fosc, sense foto -->
    <div class="relative mt-20 overflow-hidden rounded-[2rem] bg-bosc-800 px-6 py-14 text-crema-100 sm:px-12 lg:mt-28 lg:px-16 lg:py-20">
      <!-- ones de so dibuixades -->
      <svg class="pointer-events-none absolute -right-24 -top-24 h-[34rem] w-[34rem] text-crema-50/[0.06]" viewBox="0 0 200 200" fill="none" stroke="currentColor" aria-hidden="true">
        {[30, 50, 70, 90].map((r) => <circle cx="100" cy="100" r={r} stroke-width="1" />)}
      </svg>
      <div class="relative grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <span class="font-display text-7xl text-fusta-300/90 italic" style="font-weight:300">{audio.num}</span>
          <h3 class="mt-4 text-5xl !text-crema-50 sm:text-6xl" data-split>{audio.title}</h3>
          <p class="mt-6 max-w-md text-lg text-crema-200" data-reveal>{audio.text}</p>
          <a href={localizePath(audio.link.href, locale)} class="enllac mt-8 !text-fusta-300" data-reveal>
            {audio.link.label} <Icon name="fletxa" size={18} />
          </a>
        </div>
        <ul class="divide-y divide-crema-50/10 border-y border-crema-50/10 lg:col-span-7 lg:self-end" data-reveal-stagger>
          {audio.items.map((it: any) => (
            <li class="flex items-center gap-5 py-5 text-lg text-crema-50 sm:text-xl">
              <Icon name={it.icon} size={28} class="shrink-0 text-fusta-300" />
              {it.label}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

