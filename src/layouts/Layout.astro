---
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import "@styles/global.css";
import fraunces from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url";
import {
  getLocaleFromPath,
  getLocalizedData,
  localizePath,
  stripLocalePrefix,
  type Locale,
} from "@/utils/i18n";

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  /** la primera secció va per sota de la capçalera (portada a pantalla completa) */
  flush?: boolean;
}

const defaultTitle =
  "Óptica y Audiología Guinart · Gran de Sant Andreu 308, Barcelona";
const defaultDescription =
  "Óptica y audiología en Gran de Sant Andreu, 308 (Barcelona). Revisiones visuales, gafas graduadas, lentillas y adaptación de audífonos con más de 25 años de experiencia en Sant Andreu.";


const {
  title = defaultTitle,
  description = defaultDescription,
  ogImage: ogImageProp,
  noindex = false,
  flush = false,
} = Astro.props as Props;
const locale = getLocaleFromPath(Astro.url.pathname);
const site = getLocalizedData<any>(locale, "site");
// Imatge per compartir (WhatsApp, Facebook...): la de l'idioma de la pàgina
const ogImage = ogImageProp ?? `/og/optica-guinart-${locale}.jpg`;
const ogImageAlt =
  locale === "ca"
    ? "Òptica Guinart: la teva òptica de barri a Sant Andreu, Barcelona"
    : "Óptica Guinart: tu óptica de barrio en Sant Andreu, Barcelona";
const contactData = getLocalizedData<any>(locale, "contact");
// Title template: añade el nombre del sitio si la página tiene título personalizado
const siteName = "Óptica Guinart";
// Evitar duplicar la marca si ya está presente en el título
const brandInTitle = title?.toLowerCase().includes(siteName.toLowerCase());
const fullTitle =
  title && title !== defaultTitle && !brandInTitle
    ? `${title} | ${siteName}`
    : title;
// Asegurar que ogImage sea una URL absoluta cuando sea una ruta relativa y `Astro.site` esté definido
const ogImageUrl =
  Astro.site && typeof ogImage === "string" && ogImage.startsWith("/")
    ? new URL(ogImage, Astro.site).toString()
    : ogImage;
// Dimensiones OG si la imagen por defecto coincide (mejora de previews)
const ogImageDims = ogImageUrl?.includes("/og/") ? { width: 1200, height: 630 } : null;
// sameAs array limpio (solo URLs existentes)
const sameAs = [
  contactData?.socialMedia?.instagram?.url,
  contactData?.socialMedia?.facebook?.url,
  contactData?.socialMedia?.google?.url,
].filter(Boolean);
// Optional ratings sourced from contact data if available
const reviewAverage = (contactData as any)?.reviews?.average as number | undefined;
const reviewCount = (contactData as any)?.reviews?.count as number | undefined;
// Construir URL canónica absoluta si 'site' está definido en astro.config.mjs
const canonical = Astro.site
  ? new URL(Astro.url.pathname.replace(/index\.html$/, ""), Astro.site)
      .toString()
      .replace(/\/$/, Astro.url.pathname.endsWith("/") ? "/" : "")
  : Astro.url;
const alternateCa = Astro.site
  ? new URL(localizePath(Astro.url.pathname, "ca" as Locale), Astro.site).toString()
  : localizePath(Astro.url.pathname, "ca" as Locale);
const alternateEs = Astro.site
  ? new URL(localizePath(Astro.url.pathname, "es" as Locale), Astro.site).toString()
  : localizePath(Astro.url.pathname, "es" as Locale);
const robotsContent = noindex
  ? "noindex,nofollow"
  : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";
// URL de Google Maps para hasMap (si existe en contactData)
const googleMapsUrl =
  contactData?.contactInfo?.address?.googleMaps ||
  contactData?.socialMedia?.google?.url;
// Raíz del sitio para JSON-LD WebSite
const siteRoot = Astro.site
  ? new URL("/", Astro.site).toString()
  : typeof canonical === "string"
    ? canonical
    : String(canonical);

// Breadcrumbs (visible + JSON-LD), sense el prefix d'idioma i amb els noms del menú
const navLabels: Record<string, string> = {
  ...Object.fromEntries(
    (getLocalizedData<any>(locale, "navbar").navigation.desktop as any[]).map((l) => [l.href.replace(/^\//, ""), l.label]),
  ),
  ...(site.pageNames ?? {}),
};
const cleanPath = stripLocalePrefix(Astro.url.pathname).replace(/\/$/, "");
const segments = cleanPath.split("/").filter(Boolean);
const breadcrumbs = [
  { name: locale === "ca" ? "Inici" : "Inicio", url: new URL(localizePath("/", locale), siteRoot).toString() },
  ...segments.map((seg, i) => {
    const slug = segments.slice(0, i + 1).join("/");
    const name =
      navLabels[slug] ??
      decodeURIComponent(seg)
        .replace(/-/g, " ")
        .replace(/^\w/, (c) => c.toUpperCase());
    const url = new URL(localizePath("/" + slug + "/", locale), siteRoot).toString();
    return { name, url };
  }),
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <!-- Aunque 'keywords' ya no es determinante, mantenemos una lista semántica para buscadores secundarios -->
    <meta
      name="keywords"
      content="optica, óptica, audiologia, audiología, guinart, óptica barcelona, óptica sant andreu, gafas graduadas, lentillas, audifonos, audífonos, revisión visual, examen vista, adaptación audífonos"
    />
    <meta name="author" content="Óptica Guinart" />
    <meta name="robots" content={robotsContent} />
    <meta name="language" content={locale} />
    <meta name="distribution" content="global" />
    <meta name="geo.region" content="ES-B" />
    <meta name="geo.placename" content="Barcelona" />
    <meta name="geo.position" content="41.4372;2.1896" />
    <meta name="ICBM" content="41.4372, 2.1896" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogImageUrl?.endsWith(".jpg") && <meta property="og:image:type" content="image/jpeg" />}
    {
      ogImageDims && (
        <>
          <meta property="og:image:width" content={String(ogImageDims.width)} />
          <meta
            property="og:image:height"
            content={String(ogImageDims.height)}
          />
          <meta
            name="twitter:image:width"
            content={String(ogImageDims.width)}
          />
          <meta
            name="twitter:image:height"
            content={String(ogImageDims.height)}
          />
        </>
      )
    }
    <meta property="og:site_name" content="Óptica Guinart" />
    <meta property="og:locale" content={locale === "ca" ? "ca_ES" : "es_ES"} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />
    <!-- Twitter site/creator (si se dispone) -->
    {
      contactData?.socialMedia?.instagram?.text && (
        <meta
          name="twitter:creator"
          content={contactData.socialMedia.instagram.text}
        />
      )
    }

    <!-- Canonical URL -->
    <link rel="canonical" href={canonical} />

    <!-- Favicon y otros -->
    <!-- Favicon SVG + ICO correctamente tipados -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Apple / Safari pinned tab -->
    <link rel="mask-icon" href="/favicon.svg" color="#1e5a3d" />

    <!-- Manifest PWA -->
    <link rel="manifest" href="/manifest.webmanifest?v=5" />

    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fcfaf5" />
    <meta name="format-detection" content="telephone=no,address=no,email=no" />
    <link rel="alternate" hreflang="ca-ES" href={alternateCa} />
    <link rel="alternate" hreflang="es-ES" href={alternateEs} />
    <link rel="alternate" hreflang="x-default" href={alternateCa} />

    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="preload" href={fraunces} as="font" type="font/woff2" crossorigin />

    <!-- Marca que hi ha JS (per amagar abans d'animar); si l'animació no arrenca, es mostra tot igualment -->
    <script is:inline>
      document.documentElement.classList.add("js");
      setTimeout(function () {
        if (!window.__moviment) document.documentElement.classList.remove("js");
      }, 2500);
    </script>

    <!-- Structured Data (JSON-LD) dinámico usando contactData -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Optician",
        name: "Óptica y Audiología Guinart",
        description,
        image: ogImageUrl,
        url: canonical,
        "@id": canonical,
        telephone: contactData.contactInfo.phone.display
          .replace(/\s+/g, "")
          .replace(/^\+34/, "+34 "),
        email: contactData.contactInfo.email.address,
        address: {
          "@type": "PostalAddress",
          streetAddress: contactData.contactInfo.address.street,
          addressLocality: "Barcelona",
          addressRegion: "Cataluña",
          postalCode: "08030",
          addressCountry: "ES",
        },
        geo: {
          "@type": "GeoCoordinates",
          latitude: 41.4372,
          longitude: 2.1896,
        },
        ...(reviewAverage && reviewCount
          ? {
              aggregateRating: {
                "@type": "AggregateRating",
                ratingValue: reviewAverage,
                ratingCount: reviewCount,
                bestRating: 5,
                worstRating: 1,
              },
            }
          : {}),
        openingHoursSpecification: [
          {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            opens: "09:30",
            closes: "13:30",
          },
          {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            opens: "17:00",
            closes: "20:30",
          },
          {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Saturday"],
            opens: "10:00",
            closes: "13:30",
          },
        ],
        sameAs,
        priceRange: "€€",
        areaServed: { "@type": "City", name: "Barcelona" },
        hasMap: googleMapsUrl,
        contactPoint: [
          {
            "@type": "ContactPoint",
            telephone:
              "+" +
              (contactData.socialMedia.whatsapp.url.match(
                /wa\.me\/(\d+)/
              )?.[1] ||
                contactData.contactInfo.phone.display.replace(/\D/g, "")),
            contactType: "customer service",
            areaServed: "ES",
            availableLanguage: ["es"],
          },
        ],
      })}
    />

    <!-- Structured Data (WebSite + SearchAction) -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": siteRoot.replace(/\/$/, "") + "#website",
        url: siteRoot,
        name: "Óptica Guinart",
        potentialAction: {
          "@type": "SearchAction",
          target:
            siteRoot.replace(/\/$/, "") + "/products?q={search_term_string}",
          "query-input": "required name=search_term_string",
        },
      })}
    />
    <!-- BreadcrumbList Structured Data -->
    {
      breadcrumbs.length > 1 && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            itemListElement: breadcrumbs.map((b, idx) => ({
              "@type": "ListItem",
              position: idx + 1,
              name: b.name,
              item: b.url,
            })),
          })}
        />
      )
    }
  </head>
  <body>
    <a href="#contingut" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-60 focus:rounded-full focus:bg-bosc-700 focus:px-5 focus:py-3 focus:text-crema-50">{site.skip}</a>
    <Navbar />
    <main id="contingut" class={flush ? "" : "pt-24"}>
      {
        breadcrumbs.length > 1 && (
          <nav aria-label="Breadcrumb" class="contenidor pt-4 pb-2 text-sm text-tinta-suau">
            <ol class="flex flex-wrap items-center gap-1">
              {breadcrumbs.map((b, i) => (
                <li class="flex items-center">
                  {i < breadcrumbs.length - 1 ? (
                    <a href={b.url} class="hover:text-bosc-700">{b.name}</a>
                  ) : (
                    <span aria-current="page" class="text-tinta">{b.name}</span>
                  )}
                  {i < breadcrumbs.length - 1 && <span class="mx-2 text-crema-300">/</span>}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <script>
      import "@scripts/moviment";
    </script>
  </body>
</html>
